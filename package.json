{
  "name": "vocab-observatory-local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:reset": "docker compose down -v && docker compose up -d && node -e \"setTimeout(()=>process.exit(0),3000)\" && npm run db:setup",
    "sync:vault": "tsx scripts/sync-vault.ts"
  },
  "dependencies": {
    "@open-spaced-repetition/binding": "^0.3.0",
    "@react-three/fiber": "^9.6.1",
    "@types/sanitize-html": "^2.16.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.1",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.9.0",
    "marked": "^18.0.2",
    "next": "^16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.18.7",
    "sanitize-html": "^2.17.3",
    "server-only": "^0.0.1",
    "three": "^0.184.0",
    "ts-fsrs": "^5.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
